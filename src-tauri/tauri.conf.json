{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typst Equation Clipboard",
  "version": "0.1.0",
  "identifier": "dev.typst-equation.clipboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Typst Equation Clipboard",
        "width": 1080,
        "height": 680,
        "minWidth": 780,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
